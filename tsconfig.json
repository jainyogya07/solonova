{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "strict": false,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "types": [
            "node",
            "react",
            "react-dom"
        ],
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "src/**/*",
        "server.ts"
    ]
}