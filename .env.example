# Solonova Backend Environment Variables
# Copy this file to .env and fill in your API keys

# Cerebras API
CEREBRAS_KEY=your_cerebras_api_key_here
CEREBRAS_URL=https://api.cerebras.ai/v1/chat/completions

# Gemini API (via Raindrop or direct)
GEMINI_KEY=your_gemini_api_key_here
GEMINI_URL=https://api.raindrop.ai/v1/gemini

# Vultr API
VULTR_KEY=your_vultr_api_key_here
VULTR_URL=https://api.vultr.com/v2/compute/run
